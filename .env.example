# Backend used by the evaluator: gemini (default) or groq
EVAL_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Záložní modely (oddělené čárkou), zkouší se postupně při 503/404 primárního:
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
# Minimální rozestup mezi požadavky na Gemini (sekundy), aby se předešlo 429
# kvůli free-tier limitu požadavků za minutu. 0 = vypnuto.
GEMINI_MIN_INTERVAL_SECONDS=6.5

# Groq (https://console.groq.com) - alternativa k Gemini při EVAL_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant
GROQ_MIN_INTERVAL_SECONDS=0

# Database
DATABASE_URL=sqlite:///opportunities.db

# GraphQL API (required; send as Authorization: Bearer <API_TOKEN>)
API_TOKEN=

# Notifications
MIN_SCORE=80

# Slack (Incoming Webhook)
SLACK_WEBHOOK=

# Email (SMTP over SSL)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_RECIPIENT=
